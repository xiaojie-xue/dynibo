    </inertial>
  </link>
  <joint name="fer_joint1" type="revolute">
    <origin xyz="0 0 0.333" rpy="0 0 0"/>
    <parent link="fer_link0"/>
    <child link="fer_link1"/>
    <axis xyz="0 0 1"/>
    <limit effort="87.0" lower="-2.8973" upper="2.8973" velocity="2.1750"/>
  </joint>

