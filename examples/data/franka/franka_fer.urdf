<?xml version="1.0"?>
<!--
  Standalone dynamics example derived from the FER model in Franka Robotics'
  official franka_description package (Apache-2.0):
  https://github.com/frankarobotics/franka_description

  Visual, collision, transmission, and ros2_control elements are intentionally
  omitted because dynibo only consumes kinematic and inertial data.
-->
<robot name="franka_fer">
  <link name="fer_link0">
    <inertial>
      <origin xyz="-0.0172 0.0004 0.0745" rpy="0 0 0"/>
      <mass value="2.3966"/>
      <inertia ixx="0.0090" ixy="0.0000" ixz="0.0020" iyy="0.0115" iyz="0.0000" izz="0.0085"/>
    </inertial>
  </link>

  <link name="fer_link1">
    <inertial>
      <origin xyz="0.00033 -0.02204 -0.04762" rpy="0 0 0"/>
